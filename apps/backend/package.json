{
  "name": "@app/backend",
  "version": "0.0.1",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "start:migrate": "prisma migrate deploy && npm run start",
    "generate:prisma": "prisma generate",
    "test": "jest",
    "test:unit": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --coverage --ci --watchAll=false",
    "test:integration": "jest --config jest.integration.config.js",
    "test:integration:ci": "jest --config jest.integration.config.js --ci --watchAll=false",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "check-types": "prisma generate && tsc --noEmit"
  },
  "overrides": {
    "ajv": "^8.17.1"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/request-context": "^7.0.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/shared": "*",
    "ajv-formats": "^3.0.1",
    "ajv-v8": "npm:ajv@^8.17.1",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.2.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "jsonwebtoken": "^9.0.3",
    "ms": "^2.1.3",
    "pino": "^9.7.0",
    "pino-pretty": "^13.0.0",
    "prisma": "^7.8.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@repo/eslint-config": "*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^0.7.34",
    "@types/node": "^24.1.0",
    "@types/pg": "^8.23.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.6.0",
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.10",
    "pg": "^8.23.0",
    "prettier": "^3.8.3",
    "testcontainers": "^12.1.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.1"
  }
}
